<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_screen_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".telecom.InCallActivity">

    <TextView
        android:id="@+id/callTopLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/call_ui_phone_call"
        android:textColor="@color/call_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/callAvatarText"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_call_avatar"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="42sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callTopLabel"
        tools:text="A" />

    <TextView
        android:id="@+id/callTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callAvatarText"
        tools:text="+86 138 0013 8000" />

    <TextView
        android:id="@+id/callNumberText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/call_text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callTitleText"
        tools:text="+86 138 0013 8000"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/callLocationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/call_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callNumberText"
        tools:text="广东·深圳·中国移动"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/callStatusText"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/call_ui_connecting"
        android:textColor="@color/call_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callLocationText" />

    <LinearLayout
        android:id="@+id/callActiveControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="168dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callMuteButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_button_neutral"
                android:contentDescription="@string/call_ui_mute"
                android:padding="19dp"
                android:src="@drawable/ic_call_mic"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_ui_mute"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callKeypadButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_button_neutral"
                android:contentDescription="@string/call_ui_keypad"
                android:padding="19dp"
                android:src="@drawable/ic_call_keypad"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_ui_keypad"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callSpeakerButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_button_neutral"
                android:contentDescription="@string/call_ui_speaker"
                android:padding="18dp"
                android:src="@drawable/ic_call_speaker"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_ui_speaker"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/callDtmfPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="150dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/callDtmfDigits"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:ellipsize="start"
            android:gravity="center"
            android:hint="@string/call_ui_dtmf_hint"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/call_text_secondary"
            android:textSize="20sp"
            tools:text="1234" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <TextView
                android:id="@+id/callDtmf1"
                style="@style/CallDtmfKey"
                android:text="1" />

            <TextView
                android:id="@+id/callDtmf2"
                style="@style/CallDtmfKey"
                android:text="2" />

            <TextView
                android:id="@+id/callDtmf3"
                style="@style/CallDtmfKey"
                android:text="3" />

            <TextView
                android:id="@+id/callDtmf4"
                style="@style/CallDtmfKey"
                android:text="4" />

            <TextView
                android:id="@+id/callDtmf5"
                style="@style/CallDtmfKey"
                android:text="5" />

            <TextView
                android:id="@+id/callDtmf6"
                style="@style/CallDtmfKey"
                android:text="6" />

            <TextView
                android:id="@+id/callDtmf7"
                style="@style/CallDtmfKey"
                android:text="7" />

            <TextView
                android:id="@+id/callDtmf8"
                style="@style/CallDtmfKey"
                android:text="8" />

            <TextView
                android:id="@+id/callDtmf9"
                style="@style/CallDtmfKey"
                android:text="9" />

            <TextView
                android:id="@+id/callDtmfStar"
                style="@style/CallDtmfKey"
                android:text="*" />

            <TextView
                android:id="@+id/callDtmf0"
                style="@style/CallDtmfKey"
                android:text="0" />

            <TextView
                android:id="@+id/callDtmfHash"
                style="@style/CallDtmfKey"
                android:text="#" />
        </GridLayout>

        <TextView
            android:id="@+id/callDtmfClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/call_ui_keypad_hide"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/callEndContainer"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/callEndButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_call_button_decline"
            android:contentDescription="@string/call_ui_end"
            android:padding="21dp"
            android:rotation="135"
            android:src="@drawable/ic_call_phone"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/call_ui_end"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/callIncomingControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callDeclineButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_button_decline"
                android:contentDescription="@string/call_ui_decline"
                android:padding="21dp"
                android:rotation="135"
                android:src="@drawable/ic_call_phone"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_ui_decline"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="64dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/callAnswerButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_button_accept"
                android:contentDescription="@string/call_ui_answer"
                android:padding="21dp"
                android:src="@drawable/ic_call_phone"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_ui_answer"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
